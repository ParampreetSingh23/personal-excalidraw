{
  "name": "draw",
  "main": "worker/index.ts",
  "compatibility_date": "2025-11-01",
  // no *.workers.dev URL: it would bypass Cloudflare Access on the domain
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "draw.parampreetsingh.dev", "custom_domain": true }],
  "assets": {
    "directory": "./excalidraw-app/build",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    // fill in: `npx wrangler kv namespace create DRAWINGS`
    { "binding": "DRAWINGS", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ]
}
